# VCO Commerce (optional). Leave VCO_API_KEY empty to keep the current local shop and checkout.
# Never put VCO_API_KEY in NEXT_PUBLIC_* vars or client code.

NEXT_PUBLIC_VCO_API_URL=https://portal.virtualclinicos.com
NEXT_PUBLIC_VCO_BRAND_ID=rsrv
VCO_API_KEY=

